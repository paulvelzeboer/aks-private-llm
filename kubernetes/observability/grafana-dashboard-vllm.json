{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Managed Prometheus",
      "description": "The Azure Monitor workspace datasource auto-added to Managed Grafana.",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "Private LLM — vLLM & Gateway",
  "uid": "private-llm",
  "tags": ["private-llm", "vllm", "litellm"],
  "timezone": "",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "${DS_PROMETHEUS}", "value": "${DS_PROMETHEUS}" }
      }
    ]
  },
  "panels": [
    {
      "type": "row", "title": "vLLM — load", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries", "title": "Requests running vs waiting",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 10 } } },
      "targets": [
        { "refId": "A", "expr": "sum(vllm:num_requests_running)", "legendFormat": "running" },
        { "refId": "B", "expr": "sum(vllm:num_requests_waiting)", "legendFormat": "waiting (queued)" }
      ]
    },
    {
      "type": "timeseries", "title": "KV-cache usage %",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1 } },
      "targets": [
        { "refId": "A", "expr": "avg(vllm:gpu_cache_usage_perc)", "legendFormat": "gpu kv-cache" }
      ]
    },
    {
      "type": "row", "title": "vLLM — throughput & latency", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }
    },
    {
      "type": "timeseries", "title": "Token throughput (tokens/s)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "none" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(vllm:prompt_tokens_total[5m]))", "legendFormat": "prompt" },
        { "refId": "B", "expr": "sum(rate(vllm:generation_tokens_total[5m]))", "legendFormat": "generation" }
      ]
    },
    {
      "type": "timeseries", "title": "End-to-end request latency (p50/p95/p99)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(vllm:e2e_request_latency_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:e2e_request_latency_seconds_bucket[5m])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(vllm:e2e_request_latency_seconds_bucket[5m])))", "legendFormat": "p99" }
      ]
    },
    {
      "type": "row", "title": "Gateway (LiteLLM)", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 }
    },
    {
      "type": "timeseries", "title": "Gateway requests/s by key/user",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "targets": [
        { "refId": "A", "expr": "sum by (api_key_alias) (rate(litellm_requests_metric_total[5m]))", "legendFormat": "{{api_key_alias}}" }
      ]
    },
    {
      "type": "timeseries", "title": "Gateway request latency p95",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(litellm_request_total_latency_metric_bucket[5m])))", "legendFormat": "p95" }
      ]
    }
  ]
}
